# App
NEXT_PUBLIC_APP_NAME="Tesla Explorer"

# Neon Postgres (Auth.js sessions + profile)
# Console: https://console.neon.tech → project → Connection string
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Go-Ai gateway (OpenAI-compatible)
GO_AI_BASE_URL=http://localhost:8080
GO_AI_SHARED_SECRET=
GO_AI_MODEL=default

# Mapbox (publishable)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: YouTube Data API v3 (place reel embeds). Without it we try InnerTube guest search.
YOUTUBE_API_KEY=
